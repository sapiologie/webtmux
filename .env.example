# Copy this file to .env and fill in your key. .env is gitignored.
# webtmux loads .env from the current directory on startup.

# Mistral API key enabling voice control (push-to-talk). Required for /voice.
MISTRAL_API_KEY=

# Optional model overrides (defaults shown).
# MISTRAL_MODEL=voxtral-mini-latest
# MISTRAL_ROUTER_MODEL=mistral-small-latest
